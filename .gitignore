.DS_Store
.wrangler/

# OMC session state, not part of the site
.omc/

# TV packages. Rebuild with ./build-tvs.sh — do not commit binaries.
dist/

# Bytecode from running the patch_*.py scripts. Not app code, and build-tvs.sh does not exclude it.
__pycache__/

# playwright and its friends, for the *.smoke.mjs harnesses. npm ci restores them.
node_modules/

# The built Mac launcher and its intermediates. `bash mac/build-app.sh`
# rebuilds all three in a second from BlazingGames.applescript and
# make-icon.py, and a binary nobody can diff is how a stale build ships.
mac/build/
mac/BlazingGames.iconset/
mac/BlazingGames.icns
mac/BlazingGames-512.png
